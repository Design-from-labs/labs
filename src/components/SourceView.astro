---
import { Code } from "astro:components";
import CopyButton from "./CopyButton.astro";

interface Props {
  id: string;
  path: string;
  content: string;
}
const { id, path, content } = Astro.props;
const lang = path.endsWith(".css") ? "css" : path.endsWith(".ts") ? "ts" : "tsx";
---
<figure class="overflow-hidden rounded-lg border">
  <figcaption class="flex items-center justify-between gap-3 border-b bg-muted/40 py-1.5 ps-3 pe-1.5">
    <span class="truncate font-mono text-muted-foreground text-xs">{path}</span>
    <CopyButton target={id} label="Copy source" />
  </figcaption>
  <div id={id} class="max-h-[32rem] overflow-auto" data-source={path} tabindex="0" role="region" aria-label={`Source of ${path}`}>
    <Code code={content} lang={lang} themes={{ light: "github-light", dark: "github-dark-default" }} wrap={false} />
  </div>
</figure>
