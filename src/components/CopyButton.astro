---
// A copy button. The text comes from `text`, or from the element whose id is
// `target` (its textContent). Wired by src/scripts/ui.ts.
interface Props {
  text?: string;
  target?: string;
  label?: string;
  class?: string;
}
const { text, target, label = "Copy", class: className = "" } = Astro.props;
---
<button
  type="button"
  data-copy={text}
  data-copy-target={target}
  class:list={[
    "inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md border bg-background px-2 font-medium text-muted-foreground text-xs transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring",
    className,
  ]}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
  <span data-copy-label>{label}</span>
</button>
