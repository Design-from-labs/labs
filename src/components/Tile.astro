---
import Demos from "../../.generated/Demos.astro";
import { defaultVariant, type Entry } from "../lib/data";
import { loopAttr, tileLabel, tileOf } from "../lib/tile";
import { previewName } from "../lib/transitions";
import Stage from "./Stage.astro";

interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const variant = defaultVariant(entry);
const exportsText = (variant?.exports ?? []).join(", ");
const tile = tileOf(entry);
const hydrate = entry.loop?.hydrate === true;
// A layout part shows its device frame; the frame carries the shared name.
const staged = Boolean(entry.stage && variant?.demo);
const surfaceClass = ["specimen-surface", tile.surface === "dark" ? "dark" : null]
  .filter(Boolean)
  .join(" ");
// A component that paints its own stage does so with its prefixed
// `--<name>-surface` (contract section 2); on the wall it sits directly on
// the tile instead, so there is one surface, not two.
const specimen = {
  style: `--${entry.name}-surface: transparent;`,
  "data-specimen": entry.name,
  "data-loop": loopAttr(entry),
  "data-loop-paused": "",
  "data-surface": tile.surface,
  "data-loop-hydrate": hydrate ? "" : undefined,
  dir: "ltr",
  inert: true,
  "aria-hidden": "true" as const,
};
---
<!--
  A specimen: the component alone on its tile, no text of its own. The tile is
  the link (its name is the aria-label) and draws the focus ring. The surface
  carries the view-transition name the component page's hero shares, so the
  specimen grows into that page (decisions 0012, 0019). The loop driver
  (src/scripts/specimens.ts) plays fake states on it (decision 0020).
-->
<li class="specimen-cell" style={`--span: ${tile.span}; --rows: ${tile.rows};`} data-span={tile.span} data-rows={tile.rows}>
  <a
    href={`/ui/${entry.name}`}
    class="specimen-tile"
    aria-label={tileLabel(entry)}
    data-tile={entry.name}
    data-surface={tile.surface}
  >
    {
      staged && variant && entry.stage ? (
        <div class={surfaceClass} data-staged {...specimen}>
          <Stage item={variant.name} title={entry.title} stage={entry.stage} mode={hydrate ? "live" : "still"} vtName={previewName(entry.name)} />
        </div>
      ) : (
        <div class={`${surfaceClass} vt-tile-preview`} transition:name={previewName(entry.name)} transition:animate="initial" {...specimen}>
          {variant?.demo ? (
            <div class="specimen-fit" data-specimen-fit>
              <Demos item={variant.name} hydrate={hydrate} />
            </div>
          ) : (
            <div class="specimen-fit" data-specimen-fit>
              <code class="max-w-full break-all text-center font-mono text-base text-muted-foreground sm:text-lg">{exportsText || entry.title}</code>
            </div>
          )}
        </div>
      )
    }
  </a>
</li>
