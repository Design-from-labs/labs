---
import Demos from "../../.generated/Demos.astro";
import { defaultVariant, type Entry, KIND_LABELS, published } from "../lib/data";
import { previewName, titleName } from "../lib/transitions";

interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const variant = defaultVariant(entry);
const count = published(entry).length;
const exportsText = (variant?.exports ?? []).join(", ");
---
<!--
  One object per entry: a static, server-rendered preview and its title. The
  whole card is the link's hit area (stretched link) and shows the focus ring.
  The preview and title carry the view-transition names that the component
  page's hero and heading share, so the card grows into that page
  (docs/decisions/0012-gallery-view-transitions.md).
-->
<article
  class="group relative flex h-full flex-col rounded-lg border bg-card transition-colors hover:border-foreground/30 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring"
  data-tile={entry.name}
>
  <div
    class="vt-tile-preview relative flex h-52 items-center justify-center overflow-hidden rounded-t-lg border-b bg-muted/30 p-6"
    transition:name={previewName(entry.name)}
    transition:animate="initial"
    data-tile-preview
    dir="ltr"
    inert
    aria-hidden="true"
  >
    {
      variant?.demo ? (
        <div class="pointer-events-none origin-center scale-90">
          <Demos item={variant.name} />
        </div>
      ) : (
        <code class="font-mono text-muted-foreground text-sm">{exportsText || entry.title}</code>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="min-w-0 font-medium">
        <a href={`/ui/${entry.name}`} class="outline-none after:absolute after:inset-0 after:rounded-lg">
          <span class="vt-tile-title inline-block" transition:name={titleName(entry.name)} transition:animate="initial">{entry.title}</span>
        </a>
      </h3>
      <span class="font-mono text-[11px] text-muted-foreground uppercase tracking-wide">{KIND_LABELS[entry.kind]}</span>
    </div>
    <p class="line-clamp-2 text-muted-foreground text-sm">{entry.description}</p>
    <p class="mt-auto pt-2 font-mono text-[11px] text-muted-foreground">
      {count} {count === 1 ? "variant" : "variants"}{entry.label ? ` · ${entry.label}` : ""}
    </p>
  </div>
</article>
