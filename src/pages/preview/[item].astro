---
// A bare render of one variant's demo, used by scripts/previews.mjs to take
// the gallery still. A layout part (meta `stage`) is shown in its device
// frame. Not linked from the site and not indexed.
import Demos from "../../../.generated/Demos.astro";
import Stage from "../../components/Stage.astro";
import "../../styles/global.css";
import { entries } from "../../lib/data";

export function getStaticPaths() {
  return entries.flatMap((entry) =>
    entry.variants
      .filter((v) => v.published && v.demo)
      .map((v) => ({ params: { item: v.name }, props: { entry } })),
  );
}
const { item } = Astro.params;
const { entry } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{entry.title} preview</title>
  </head>
  <body class="m-0 bg-background">
    <main class="flex h-[750px] w-[1200px] items-center justify-center" data-preview>
      {/* Stage previews already carry an sr-only h1 in the framed document. */}
      {!entry.stage && <h1 class="sr-only">{entry.title} preview</h1>}
      {
        entry.stage ? (
          <div class="w-[1040px] [--stage-fit-h:620px]">
            <Stage item={item} title={entry.title} stage={entry.stage} mode="still" />
          </div>
        ) : (
          <div class="scale-[1.6]"><Demos item={item} hydrate={entry.loop?.hydrate === true} /></div>
        )
      }
    </main>
  </body>
</html>
