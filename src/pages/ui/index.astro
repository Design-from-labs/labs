---
import Command from "../../components/Command.astro";
import Tile from "../../components/Tile.astro";
import Base from "../../layouts/Base.astro";
import { components, data, foundations } from "../../lib/data";
---
<Base
  title="UI"
  description="Live demos of Design From Labs components on Radix, Base UI and React Aria, with Lucide or Phosphor icons."
>
  <section class="py-12 sm:py-16">
    <h1 class="font-serif text-5xl tracking-tight sm:text-6xl">Labs UI</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground text-lg">
      Components built on Radix, Base UI or React Aria, with Lucide or Phosphor icons. Install
      them with the shadcn CLI, the <code class="font-mono text-base">{data.site.cli}</code> CLI or
      npm.
    </p>
    <div class="mt-6 grid max-w-xl grid-cols-1 gap-2">
      <Command command="npx designfrom list" label="List every component" />
    </div>
  </section>

  <section aria-labelledby="components-heading" class="pb-12">
    <h2 id="components-heading" class="mb-4 font-medium text-muted-foreground text-sm">Components</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-testid="gallery">
      {components.map((entry) => <li><Tile entry={entry} /></li>)}
    </ul>
  </section>

  {
    foundations.length > 0 && (
      <section aria-labelledby="foundations-heading">
        <h2 id="foundations-heading" class="mb-4 font-medium text-muted-foreground text-sm">Foundations</h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {foundations.map((entry) => <li><Tile entry={entry} /></li>)}
        </ul>
      </section>
    )
  }
</Base>
