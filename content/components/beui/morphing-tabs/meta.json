{
  "$schema": "https://labs.designfrom.com/schemas/meta.schema.json",
  "schemaVersion": 1,
  "name": "morphing-tabs",
  "kind": "component",
  "title": "Morphing Tabs",
  "description": "Browser-style tabs on a liquid surface that flows into the active tab, with drag and keyboard reordering and optional close buttons.",
  "status": "beta",
  "category": "navigation",
  "label": "beUI",
  "variants": [
    {
      "name": "morphing-tabs-radix-lucide",
      "primitive": "radix",
      "iconSet": "lucide",
      "status": "beta"
    },
    {
      "name": "morphing-tabs-radix-phosphor",
      "primitive": "radix",
      "iconSet": "phosphor",
      "status": "beta"
    },
    {
      "name": "morphing-tabs-base-lucide",
      "primitive": "base",
      "iconSet": "lucide",
      "status": "beta"
    },
    {
      "name": "morphing-tabs-base-phosphor",
      "primitive": "base",
      "iconSet": "phosphor",
      "status": "beta"
    },
    {
      "name": "morphing-tabs-aria-lucide",
      "primitive": "aria",
      "iconSet": "lucide",
      "status": "beta"
    },
    {
      "name": "morphing-tabs-aria-phosphor",
      "primitive": "aria",
      "iconSet": "phosphor",
      "status": "beta"
    }
  ],
  "defaultVariant": "morphing-tabs-radix-lucide",
  "demo": "demo.tsx",
  "preview": "preview.webp",
  "source": {
    "repo": "https://github.com/starc007/ui-components",
    "commit": "7bb802bc0123fa8944bc327060e60a5bae8c65bc",
    "path": "components/motion/morphing-tabs.tsx"
  },
  "author": "Saurabh Chauhan <https://github.com/starc007>",
  "license": "MIT",
  "attribution": "Copyright (c) 2026 Saurabh Chauhan. MIT License.",
  "credits": [
    "S-232",
    "S-003",
    "S-004",
    "S-008",
    "S-019",
    "S-020",
    "S-104",
    "S-032",
    "S-033",
    "S-034",
    "S-005",
    "S-006",
    "S-239",
    "S-152",
    "S-157",
    "S-237"
  ],
  "date": "2026-10-13",
  "tile": {
    "span": 2,
    "rows": 2
  },
  "loop": {
    "script": "click[2] → wait → click[3] → wait → click[1] → wait",
    "duration": 6000,
    "hydrate": true
  },
  "tags": [
    "tabs",
    "motion",
    "drag",
    "reorder",
    "spring",
    "reduced-motion"
  ],
  "props": [
    {
      "name": "items",
      "type": "{ id: string; label: string; icon?: React.ReactNode; content: React.ReactNode; disabled?: boolean }[]",
      "description": "The tabs and their panels."
    },
    {
      "name": "value / defaultValue",
      "type": "string | null",
      "description": "The selected tab (controlled or initial)."
    },
    {
      "name": "onValueChange",
      "type": "(id: string | null) => void",
      "description": "Called when the selection changes."
    },
    {
      "name": "onOrderChange",
      "type": "(ids: string[]) => void",
      "description": "Called once after a drag or keyboard reorder."
    },
    {
      "name": "onClose",
      "type": "(id: string) => void",
      "description": "Shows a close button on every tab."
    },
    {
      "name": "ariaLabel",
      "type": "string",
      "default": "\"Tabs\"",
      "description": "The tablist's accessible name."
    },
    {
      "name": "classNames",
      "type": "{ root?, rail?, tab?, activeTab?, icon?, label?, close?, content? }",
      "description": "Classes per part."
    }
  ],
  "a11y": [
    "The primitive's tabs pattern: role=tablist/tab/tabpanel, roving focus, Arrow keys (in the reading direction), Home and End, automatic activation.",
    "Alt+Arrow moves the focused tab; the order change is reported once through onOrderChange.",
    "Close buttons are named \"Close <label>\" and sit outside the tablist, so the tablist owns only tabs.",
    "Reduced motion: the springs and the liquid surface snap; panels cross-fade without blur or movement."
  ],
  "usage": "<MorphingTabs\n  items={items}\n  value={value}\n  onValueChange={setValue}\n  onOrderChange={reorder}\n  ariaLabel=\"Rooms\"\n/>"
}
