{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.generated",
      "!pnpm-lock.yaml",
      "!content/components",
      "!schemas/vendor",
      "!vendor/shadcn",
      "!**/*.astro",
      "!ports/torph/text-morph/text-morph*.ts*",
      "!ports/goey-toast/gooey-toast/gooey-toast*.ts*",
      "!ports/peckz-playground/dot-morph/dot-morph-motion.ts",
      "!ports/*/*/src",
      "!ports/samasante-liquid-glass/glass/glass*.ts*",
      "!ports/jal-co-holosticker/holo-sticker/holo-sticker-renderer.ts",
      "!ports/dmitrykurash-holocloth/holo-foil/holo-foil-scene.ts",
      "!ports/dmitrykurash-holocloth/holo-foil/holo-foil-pose.ts",
      "!ports/lisse/smooth-corners/smooth-corners*.ts*",
      "!ports/cloudflare-kumo/flow-diagram/flow-diagram*.ts*",
      "!ports/shpigford-dither/vector-dither/vector-dither-core.ts",
      "!ports/yousuf-viscose-carousel/viscose-carousel/viscose-carousel-engine.ts",
      "!ports/yousuf-viscose-carousel/viscose-carousel/viscose-carousel-shaders.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
