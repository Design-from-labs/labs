{
  "name": "design-from-labs",
  "private": true,
  "type": "module",
  "description": "Design From Labs: experiments and production-ready components",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "examples": "node scripts/export-labs-examples.mjs",
    "examples:check": "node scripts/export-labs-examples.mjs --check",
    "ports": "node scripts/export-ports.mjs",
    "ports:check": "node scripts/export-ports.mjs --check",
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "pnpm prepare:content && astro dev",
    "build": "pnpm prepare:content && astro build && pnpm --filter @designfrom/react --filter designfrom build",
    "build:site": "pnpm prepare:content && astro build",
    "preview": "astro preview --port ${E2E_PORT:-4321}",
    "previews": "node scripts/previews.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:refs": "node scripts/check-external-refs.mjs --require-patterns",
    "check:sources": "node scripts/check-sources.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm prepare:content && astro check && pnpm --filter @designfrom/react --filter designfrom typecheck",
    "test": "node --test \"scripts/**/*.test.mjs\" && pnpm --filter designfrom test",
    "e2e": "playwright test",
    "pack:dry": "pnpm --filter @designfrom/react --filter designfrom pack:dry",
    "verify": "pnpm examples:check && pnpm ports:check && pnpm validate:content && pnpm check:licenses && pnpm check:sources && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:dry && pnpm e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "7.0.1",
    "@axe-core/playwright": "4.13.0",
    "@base-ui/react": "1.9.0",
    "@biomejs/biome": "2.5.15",
    "@date-fns/utc": "2.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.64.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "9.2.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.3",
    "ajv": "8.20.0",
    "astro": "7.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cobe": "2.0.1",
    "date-fns": "4.4.0",
    "driver.js": "1.9.0",
    "lenis": "1.3.26",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "roughjs": "4.3.1",
    "shadcn": "4.21.4",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tegaki": "1.1.0",
    "three": "0.185.1",
    "three-custom-shader-material": "6.4.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vaul": "1.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
